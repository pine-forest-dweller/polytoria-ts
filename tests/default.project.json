{
	"name": "roblox-ts-tests",
	"globIgnorePaths": ["**/package.json", "**/tsconfig.json"],
	"tree": {
		"$className": "World",
		"Hidden": {
			"$className": "Hidden",
			"external": {
				"$path": "projects/external"
			},
			"referenceCommon": {
				"$path": "projects/common/out"
			},
			"referenceShared": {
				"$path": "projects/shared/out"
			},
			"include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					}
				}
			}
		},
		"ScriptService": {
			"$className": "ScriptService",
			"main": {
				"$path": "out/main.server.luau"
			},
			"tests": {
				"$path": "out/tests"
			},
			"diagnostics": {
				"$path": "out/diagnostics"
			},
			"helpers": {
				"$className": "Folder",
				"util": {
					"$path": "out/helpers/util"
				}
			}
		},
		"PlayerGUI": {
			"$className": "PlayerGUI",
			"isolated": {
				"$path": "out/helpers/rojo/isolated.luau"
			}
		}
	}
}
