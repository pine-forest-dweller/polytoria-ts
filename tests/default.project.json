{
	"name": "polytoria-ts-game",
	"globIgnorePaths": [
		"**/package.json",
		"**/tsconfig.json"
	],
	"tree": {
		"$className": "DataModel",
		"ScriptService": {
			"$className": "ScriptService",
			"main": {
				"$path": "out/main.server.luau"
			},
			"tests": {
				"$path": "out/tests"
			},
			"diagnostics": {
				"$path": "out/diagnostics"
			},
			"helpers": {
				"$className": "Folder",
				"util": {
					"$path": "out/helpers/util"
				}
			}
		},
		"Hidden": {
			"$className": "Hidden",
			"external": {
				"$path": "projects/external"
			},
			"referenceCommon": {
				"$path": "projects/common/out"
			},
			"referenceShared": {
				"$path": "projects/shared/out"
			},
			"include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@polytoria-ts": {
						"$path": "node_modules/@polytoria-ts"
					},
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					}
				}
			},
			"TS": {
				"$path": "out/shared"
			}
		},
		"PlayerDefaults": {
			"$className": "PlayerDefaults",
			"TS": {
				"$path": "out/client"
			}
		},
		"PlayerGUI": {
			"$className": "PlayerGUI",
			"isolated": {
				"$path": "out/helpers/rojo/isolated.luau"
			}
		},
		"Environment": {
			"$className": "Environment"
		}
	}
}
